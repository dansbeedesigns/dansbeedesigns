---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Technology consulting and contracting — systems engineering, cybersecurity, and AI implementation for small and medium businesses.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dansbee Designs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Josefin+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <div class="accent-bar"></div>

    <header class="border-b border-teal-mid/25 bg-[#f0f6f6]/95 sticky top-0 z-50 backdrop-blur-sm">
      <div class="mx-auto flex max-w-5xl items-center justify-end px-6 py-3">

        <!-- Desktop nav (hidden on mobile) -->
        <div class="hidden md:flex items-center gap-6">
          <!-- Essays dropdown -->
          <div class="relative" id="essays-menu">
            <button
              id="essays-btn"
              class="font-badge text-xs font-bold uppercase tracking-[0.2em] text-teal-darkest/60 hover:text-teal-mid transition-colors flex items-center gap-1.5"
              aria-haspopup="true"
              aria-expanded="false"
            >
              Essays
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
              </svg>
            </button>
            <div
              id="essays-dropdown"
              class="absolute right-0 top-full mt-0 bg-[#f0f6f6] border border-teal-mid/20 shadow-md z-50 w-72 hidden"
              role="menu"
            >
              <a href="/insights" class="block px-5 py-4 font-badge text-xs font-semibold uppercase tracking-[0.15em] text-teal-darkest/70 hover:text-teal-mid hover:bg-teal-mid/5 transition-colors border-b border-teal-mid/15" role="menuitem">
                The Business That Grew Faster Than Its Bones
              </a>
              <a href="/ai-and-your-ip" class="block px-5 py-4 font-badge text-xs font-semibold uppercase tracking-[0.15em] text-teal-darkest/70 hover:text-teal-mid hover:bg-teal-mid/5 transition-colors border-b border-teal-mid/15" role="menuitem">
                What AI Actually Knows About Your Business
              </a>
              <a href="/identity-protection" class="block px-5 py-4 font-badge text-xs font-semibold uppercase tracking-[0.15em] text-teal-darkest/70 hover:text-teal-mid hover:bg-teal-mid/5 transition-colors" role="menuitem">
                You Are the Attack Surface
              </a>
            </div>
          </div>
          <span class="text-teal-mid/30 select-none">|</span>
          <a href="mailto:cale@dansbeedesigns.com" class="font-badge text-xs font-bold uppercase tracking-[0.2em] text-amber hover:text-amber-light transition-colors">
            Get in Touch
          </a>
        </div>

        <!-- Mobile hamburger button -->
        <button
          id="hamburger-btn"
          class="md:hidden flex flex-col justify-center items-center gap-[5px] w-8 h-8 text-teal-darkest/60 hover:text-teal-mid transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <span class="hamburger-line block w-5 h-[1.5px] bg-current transition-all duration-200"></span>
          <span class="hamburger-line block w-5 h-[1.5px] bg-current transition-all duration-200"></span>
          <span class="hamburger-line block w-5 h-[1.5px] bg-current transition-all duration-200"></span>
        </button>
      </div>
    </header>

    <!-- Mobile menu overlay -->
    <div id="mobile-overlay" class="fixed inset-0 bg-teal-darkest/60 z-40 hidden" aria-hidden="true"></div>

    <!-- Mobile slide-in panel -->
    <div
      id="mobile-menu"
      class="fixed top-0 right-0 h-full w-72 max-w-[85vw] bg-[#f0f6f6] z-50 shadow-xl translate-x-full transition-transform duration-300 ease-in-out flex flex-col"
      aria-label="Navigation menu"
    >
      <!-- Panel header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-teal-mid/20">
        <span class="font-badge text-xs font-bold uppercase tracking-[0.3em] text-teal-darkest/40">Menu</span>
        <button id="mobile-close-btn" class="text-teal-darkest/50 hover:text-teal-mid transition-colors" aria-label="Close menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M3 3L15 15M15 3L3 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          </svg>
        </button>
      </div>

      <!-- Essays section -->
      <div class="border-b border-teal-mid/20">
        <p class="px-6 pt-5 pb-3 font-badge text-xs font-bold uppercase tracking-[0.3em] text-amber">Essays</p>
        <a href="/insights" class="block px-6 py-4 font-badge text-xs font-semibold uppercase tracking-[0.12em] text-teal-darkest/70 hover:text-teal-mid hover:bg-teal-mid/5 transition-colors border-t border-teal-mid/15">
          The Business That Grew Faster Than Its Bones
        </a>
        <a href="/ai-and-your-ip" class="block px-6 py-4 font-badge text-xs font-semibold uppercase tracking-[0.12em] text-teal-darkest/70 hover:text-teal-mid hover:bg-teal-mid/5 transition-colors border-t border-teal-mid/15">
          What AI Actually Knows About Your Business
        </a>
        <a href="/identity-protection" class="block px-6 py-4 font-badge text-xs font-semibold uppercase tracking-[0.12em] text-teal-darkest/70 hover:text-teal-mid hover:bg-teal-mid/5 transition-colors border-t border-teal-mid/15">
          You Are the Attack Surface
        </a>
      </div>

      <!-- Get in Touch -->
      <div class="px-6 py-6">
        <a href="mailto:cale@dansbeedesigns.com" class="font-badge text-xs font-bold uppercase tracking-[0.2em] text-amber hover:text-amber-light transition-colors">
          Get in Touch
        </a>
      </div>
    </div>

    <script>
      // ── Desktop dropdown ──────────────────────────────────────────────
      const btn = document.getElementById('essays-btn');
      const menu = document.getElementById('essays-dropdown');
      const wrapper = document.getElementById('essays-menu');
      if (btn && menu && wrapper) {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isHidden = menu.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', String(!isHidden));
        });
        menu.addEventListener('click', (e) => { e.stopPropagation(); });
        document.addEventListener('click', () => {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        });
        wrapper.addEventListener('mouseenter', () => {
          menu.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
        });
        wrapper.addEventListener('mouseleave', () => {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        });
      }

      // ── Mobile menu ───────────────────────────────────────────────────
      const hamburgerBtn = document.getElementById('hamburger-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileOverlay = document.getElementById('mobile-overlay');
      const mobileCloseBtn = document.getElementById('mobile-close-btn');

      function openMobileMenu() {
        mobileMenu.classList.remove('translate-x-full');
        mobileOverlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        hamburgerBtn.setAttribute('aria-expanded', 'true');
      }

      function closeMobileMenu() {
        mobileMenu.classList.add('translate-x-full');
        mobileOverlay.classList.add('hidden');
        document.body.style.overflow = '';
        hamburgerBtn.setAttribute('aria-expanded', 'false');
      }

      if (hamburgerBtn && mobileMenu && mobileOverlay) {
        hamburgerBtn.addEventListener('click', openMobileMenu);
        mobileCloseBtn.addEventListener('click', closeMobileMenu);
        mobileOverlay.addEventListener('click', closeMobileMenu);
        // Close on any nav link tap
        mobileMenu.querySelectorAll('a').forEach(a => {
          a.addEventListener('click', closeMobileMenu);
        });
      }
    </script>

    <main>
      <slot />
    </main>

    <footer class="border-t border-teal-mid/25 bg-teal-mid/10">
      <div class="mx-auto max-w-5xl px-6 py-10 text-center">
        <p class="font-badge text-xs font-semibold uppercase tracking-[0.2em] text-amber">
          Consulting &middot; Contracting &middot; Technology Solutions
        </p>
        <p class="mt-4 font-badge text-xs text-teal-darkest/50">
          &copy; {new Date().getFullYear()} Dansbee Designs &mdash; Cale Dansbee
        </p>
      </div>
    </footer>
  </body>
</html>
