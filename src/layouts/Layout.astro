---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Technology consulting and contracting — systems engineering, cybersecurity, and AI implementation for small and medium businesses.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dansbee Designs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Josefin+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <div class="accent-bar"></div>

    <header class="border-b border-teal-mid/25 bg-[#f0f6f6]/95 sticky top-0 z-50 backdrop-blur-sm">
      <div class="mx-auto flex max-w-5xl items-center justify-end gap-6 px-6 py-3">
        <!-- Essays dropdown -->
        <div class="relative" id="essays-menu">
          <button
            id="essays-btn"
            class="font-badge text-xs font-bold uppercase tracking-[0.2em] text-teal-darkest/60 hover:text-teal-mid transition-colors flex items-center gap-1.5"
            aria-haspopup="true"
            aria-expanded="false"
          >
            Essays
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
            </svg>
          </button>
          <div
            id="essays-dropdown"
            class="absolute right-0 top-full mt-0 bg-[#f0f6f6] border border-teal-mid/20 shadow-md z-50 w-72 max-w-[calc(100vw-1.5rem)] hidden"
            role="menu"
          >
            <a
              href="/insights"
              class="block px-5 py-4 font-badge text-xs font-semibold uppercase tracking-[0.15em] text-teal-darkest/70 hover:text-teal-mid hover:bg-teal-mid/5 transition-colors border-b border-teal-mid/15"
              role="menuitem"
            >
              The Business That Grew Faster Than Its Bones
            </a>
            <a
              href="/ai-and-your-ip"
              class="block px-5 py-4 font-badge text-xs font-semibold uppercase tracking-[0.15em] text-teal-darkest/70 hover:text-teal-mid hover:bg-teal-mid/5 transition-colors"
              role="menuitem"
            >
              What AI Actually Knows About Your Business
            </a>
          </div>
        </div>

        <script>
          const btn = document.getElementById('essays-btn');
          const menu = document.getElementById('essays-dropdown');
          const wrapper = document.getElementById('essays-menu');
          if (btn && menu && wrapper) {
            // Toggle on button click
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              const isHidden = menu.classList.toggle('hidden');
              btn.setAttribute('aria-expanded', String(!isHidden));
            });
            // Stop clicks inside the menu from reaching the document handler
            menu.addEventListener('click', (e) => {
              e.stopPropagation();
            });
            // Close on outside click
            document.addEventListener('click', () => {
              menu.classList.add('hidden');
              btn.setAttribute('aria-expanded', 'false');
            });
            // Hover open/close on desktop
            wrapper.addEventListener('mouseenter', () => {
              menu.classList.remove('hidden');
              btn.setAttribute('aria-expanded', 'true');
            });
            wrapper.addEventListener('mouseleave', () => {
              menu.classList.add('hidden');
              btn.setAttribute('aria-expanded', 'false');
            });
          }
        </script>

        <span class="text-teal-mid/30 select-none">|</span>
        <a
          href="mailto:cale@dansbeedesigns.com"
          class="font-badge text-xs font-bold uppercase tracking-[0.2em] text-amber hover:text-amber-light transition-colors"
        >
          Get in Touch
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-teal-mid/25 bg-teal-mid/10">
      <div class="mx-auto max-w-5xl px-6 py-10 text-center">
        <p class="font-badge text-xs font-semibold uppercase tracking-[0.2em] text-amber">
          Consulting &middot; Contracting &middot; Technology Solutions
        </p>
        <p class="mt-4 font-badge text-xs text-teal-darkest/50">
          &copy; {new Date().getFullYear()} Dansbee Designs &mdash; Cale Dansbee
        </p>
      </div>
    </footer>
  </body>
</html>
