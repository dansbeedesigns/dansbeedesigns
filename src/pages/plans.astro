---
import Layout from '../layouts/Layout.astro';
import { plans } from '../data/plans';
---

<Layout
  title="Project Plans | Dansbee Designs"
  description="Download the project plans that go with Dansbee Designs YouTube builds. Enter your email to get instant access — no mailing list spam."
>
  <!-- Hero -->
  <section class="border-b border-teal-mid/30 bg-teal-deep/30">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="font-badge text-xs font-semibold uppercase tracking-[0.25em] text-amber">
        YouTube Project Plans
      </p>
      <h1 class="font-display mt-4 max-w-3xl text-5xl font-bold uppercase leading-[1.05] tracking-tight text-white md:text-6xl">
        Build Along <span class="text-amber">Plans.</span>
      </h1>
      <p class="mt-6 max-w-xl font-body text-lg font-light leading-relaxed text-cream/90">
        Every plan here goes with a build on the YouTube channel. Enter your email and get the
        PDF — cut list, dimensions, and notes — no strings attached.
      </p>
    </div>
  </section>

  <!-- Plans grid -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {plans.map((plan) => (
        <div
          class="plan-card flex flex-col border border-teal-mid/30 bg-teal-darkest/40"
          data-plan-key={plan.key}
        >
          <!-- YouTube thumbnail or cover image -->
          {(plan.youtubeId || plan.coverImage) && (
            <div class="aspect-video overflow-hidden border-b border-teal-mid/30 relative group">
              <img
                src={
                  plan.youtubeId
                    ? `https://img.youtube.com/vi/${plan.youtubeId}/mqdefault.jpg`
                    : plan.coverImage
                }
                alt={plan.title}
                class="h-full w-full object-cover"
                loading="lazy"
              />
              {plan.youtubeUrl && (
                <a
                  href={plan.youtubeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="absolute inset-0 flex items-center justify-center bg-teal-darkest/40 opacity-0 group-hover:opacity-100 transition-opacity"
                  aria-label={`Watch ${plan.title} on YouTube`}
                >
                  <!-- YouTube play icon -->
                  <svg class="h-14 w-14 text-white drop-shadow-lg" viewBox="0 0 68 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M66.5 7.7C65.7 4.9 63.5 2.7 60.7 1.9 55.4 0 34 0 34 0S12.6 0 7.3 1.9C4.5 2.7 2.3 4.9 1.5 7.7 0 13 0 24 0 24s0 11 1.5 16.3c.8 2.8 3 5 5.8 5.8C12.6 48 34 48 34 48s21.4 0 26.7-1.9c2.8-.8 5-3 5.8-5.8C68 35 68 24 68 24s0-11-1.5-16.3z" fill="#FF0000"/>
                    <path d="M27 34l18-10-18-10v20z" fill="#fff"/>
                  </svg>
                </a>
              )}
            </div>
          )}

          <div class="relative flex flex-1 flex-col p-6">
            <div class="accent-bar-vertical absolute left-0 top-6 h-8"></div>

            <h2 class="font-display text-xl font-bold uppercase tracking-wide text-white">
              {plan.title}
            </h2>
            <p class="mt-3 font-body text-base font-light leading-relaxed text-cream/80">
              {plan.description}
            </p>

            {plan.youtubeUrl && (
              <a
                href={plan.youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex items-center gap-2 font-badge text-xs font-semibold uppercase tracking-[0.1em] text-cream/50 transition-colors hover:text-amber"
              >
                <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.5 12 3.5 12 3.5S4.5 3.5 2.6 4.1A3 3 0 00.5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 002.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 002.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.75 15.5v-7l6.5 3.5-6.5 3.5z"/>
                </svg>
                Watch on YouTube
              </a>
            )}

            <!-- Default state: CTA button -->
            <div class="plan-cta mt-6">
              <button
                class="plan-request-btn w-full bg-amber px-6 py-3 font-badge text-sm font-semibold uppercase tracking-[0.1em] text-teal-darkest transition-colors hover:bg-amber-light"
                type="button"
              >
                Get Free Plans
              </button>
            </div>

            <!-- Email form (hidden until button clicked) -->
            <form class="plan-form mt-6 hidden" novalidate>
              <label class="block font-badge text-xs font-semibold uppercase tracking-[0.15em] text-cream/70">
                Your Email
              </label>
              <input
                type="email"
                name="email"
                required
                placeholder="you@example.com"
                class="plan-email-input mt-2 w-full border border-teal-mid/50 bg-teal-darkest px-4 py-3 font-body text-sm text-cream placeholder-cream/40 outline-none focus:border-amber"
              />
              <p class="plan-error mt-2 hidden font-badge text-xs font-semibold text-red-400"></p>
              <button
                type="submit"
                class="plan-submit-btn mt-3 w-full bg-amber px-6 py-3 font-badge text-sm font-semibold uppercase tracking-[0.1em] text-teal-darkest transition-colors hover:bg-amber-light disabled:cursor-not-allowed disabled:opacity-50"
              >
                Get My Download Link
              </button>
              <button
                type="button"
                class="plan-cancel-btn mt-2 w-full px-6 py-2 font-badge text-xs font-semibold uppercase tracking-[0.1em] text-cream/50 transition-colors hover:text-cream"
              >
                Cancel
              </button>
            </form>

            <!-- Success state -->
            <div class="plan-success mt-6 hidden">
              <p class="font-badge text-xs font-semibold uppercase tracking-[0.15em] text-amber">
                Your plans are ready
              </p>

              <a
                href="#"
                class="plan-download-link mt-3 flex w-full items-center justify-center gap-2 bg-amber px-6 py-3 font-badge text-sm font-semibold uppercase tracking-[0.1em] text-teal-darkest transition-colors hover:bg-amber-light"
                download
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Download Plans (PDF)
              </a>

              <p class="mt-3 font-body text-xs font-light text-cream/50">
                Link expires in 1 hour. Need it again? Just re-enter your email.
              </p>
              <button
                type="button"
                class="plan-reset-btn mt-2 font-badge text-xs font-semibold uppercase tracking-[0.1em] text-cream/40 hover:text-cream/70"
              >
                ← Back
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('.plan-card').forEach((card) => {
    const planKey = card.dataset.planKey!;

    const cta         = card.querySelector<HTMLElement>('.plan-cta')!;
    const requestBtn  = card.querySelector<HTMLButtonElement>('.plan-request-btn')!;
    const form        = card.querySelector<HTMLFormElement>('.plan-form')!;
    const emailInput  = card.querySelector<HTMLInputElement>('.plan-email-input')!;
    const errorEl     = card.querySelector<HTMLElement>('.plan-error')!;
    const submitBtn   = card.querySelector<HTMLButtonElement>('.plan-submit-btn')!;
    const cancelBtn   = card.querySelector<HTMLButtonElement>('.plan-cancel-btn')!;
    const successEl   = card.querySelector<HTMLElement>('.plan-success')!;
    const downloadLink = card.querySelector<HTMLAnchorElement>('.plan-download-link')!;
    const resetBtn    = card.querySelector<HTMLButtonElement>('.plan-reset-btn')!;

    function showForm() {
      cta.classList.add('hidden');
      form.classList.remove('hidden');
      successEl.classList.add('hidden');
      emailInput.focus();
    }

    function showSuccess(token: string) {
      form.classList.add('hidden');
      cta.classList.add('hidden');
      successEl.classList.remove('hidden');
      downloadLink.href = `/api/download/${token}`;
    }

    function reset() {
      successEl.classList.add('hidden');
      form.classList.add('hidden');
      cta.classList.remove('hidden');
      emailInput.value = '';
      hideError();
    }

    function showError(msg: string) {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    }

    function hideError() {
      errorEl.textContent = '';
      errorEl.classList.add('hidden');
    }

    requestBtn.addEventListener('click', showForm);
    cancelBtn.addEventListener('click', reset);
    resetBtn.addEventListener('click', reset);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();

      const email = emailInput.value.trim();
      if (!email) {
        showError('Please enter your email address.');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Getting your link…';

      try {
        const res = await fetch('/api/request-plan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, planKey }),
        });
        const data = await res.json() as { token?: string; error?: string };
        if (!res.ok || !data.token) throw new Error(data.error ?? 'Unknown error');
        showSuccess(data.token);
      } catch (err) {
        showError(err instanceof Error ? err.message : 'Something went wrong. Please try again.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Get My Download Link';
      }
    });
  });
</script>
